    "./utilsui/progress": {
      "types": "./dist/utilsui/progress/index.d.ts",
      "default": "./dist/utilsui/progress/index.js"
    },
    "./utilsui/video": {
      "types": "./dist/utilsui/video/index.d.ts",
      "default": "./dist/utilsui/video/index.js"
    },
    "./utilsui/widgets": {
      "types": "./dist/utilsui/widgets/index.d.ts",
      "default": "./dist/utilsui/widgets/index.js"
    },
    "./utilsui/dialog": {
      "types": "./dist/utilsui/dialog/index.d.ts",
      "default": "./dist/utilsui/dialog/index.js"
    },
    "./utilsui/canvas": {
      "types": "./dist/utilsui/canvas/index.d.ts",
      "default": "./dist/utilsui/canvas/index.js"
    },
    "./utilsui/panel": {
      "types": "./dist/utilsui/panel/index.d.ts",
      "default": "./dist/utilsui/panel/index.js"
    },
    "./utilsui/list": {
      "types": "./dist/utilsui/list/index.d.ts",
      "default": "./dist/utilsui/list/index.js"
    },
    "./utilsui/markdown": {
      "types": "./dist/utilsui/markdown.d.ts",
      "default": "./dist/utilsui/markdown.js"
    },
    "./utilsui/markdown/lite": {
      "types": "./dist/utilsui/markdown/lite.d.ts",
      "default": "./dist/utilsui/markdown/lite.js"
    },
    "./utilsui/dnd": {
      "types": "./dist/utilsui/dnd/index.d.ts",
      "default": "./dist/utilsui/dnd/index.js"
    },
    "./utilsui/swiper": {
      "types": "./dist/utilsui/swiper/index.d.ts",
      "default": "./dist/utilsui/swiper/index.js"
    },
    "./utilsagent": {
      "types": "./dist/utilsagent/index.d.ts",
      "default": "./dist/utilsagent/index.js"
    },
    "./utilsagent/sse": {
      "types": "./dist/utilsagent/sse.d.ts",
      "default": "./dist/utilsagent/sse.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bunx tsc -p tsconfig.build.json",
    "check": "bunx tsc --noEmit",
    "check:isolated": "bunx tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck tests/fixtures/isolated-consumer.ts",
    "test": "bun test",
    "test:node": "bun run build && node -e \"process.env.SINDREJS_TEST_BUILD='1'; Promise.all([import('./tests/core.test.mjs'), import('./tests/adapters.test.mjs')])\""
  },
