{
  "name": "sindrejs",
  "version": "0.1.1",
  "description": "Modular TypeScript utilities for browser, Node.js, and Bun",
  "homepage": "https://github.com/SindreYang/SindreJS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SindreYang/SindreJS.git"
  },
  "bugs": {
    "url": "https://github.com/SindreYang/SindreJS/issues"
  },
  "keywords": ["typescript", "browser", "node", "bun", "canvas", "three", "onnx", "mediapipe", "react"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "docs"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./general": {
      "types": "./dist/general/index.d.ts",
      "default": "./dist/general/index.js"
    },
    "./general/3d": {
      "types": "./dist/general/io3d.d.ts",
      "default": "./dist/general/io3d.js"
    },
    "./utils2d": {
      "types": "./dist/utils2d/index.d.ts",
      "default": "./dist/utils2d/index.js"
    },
    "./utils3d": {
      "types": "./dist/utils3d/index.d.ts",
      "default": "./dist/utils3d/index.js"
    },
    "./utils3d/react": {
      "types": "./dist/utils3d/react.d.ts",
      "default": "./dist/utils3d/react.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./ai/mediapipe": {
      "types": "./dist/ai/mediapipe.d.ts",
      "default": "./dist/ai/mediapipe.js"
    },
    "./ai/mediapipe/audio": {
      "types": "./dist/ai/mediapipe_audio.d.ts",
      "default": "./dist/ai/mediapipe_audio.js"
    },
    "./ai/mediapipe/text": {
      "types": "./dist/ai/mediapipe_text.d.ts",
      "default": "./dist/ai/mediapipe_text.js"
    },
    "./ai/mediapipe/genai": {
      "types": "./dist/ai/mediapipe_genai.d.ts",
      "default": "./dist/ai/mediapipe_genai.js"
    },
    "./ai/tfjs": {
      "types": "./dist/ai/tfjs/index.d.ts",
      "default": "./dist/ai/tfjs/index.js"
    },
    "./ai/onnx/web": {
      "types": "./dist/ai/onnx/web.d.ts",
      "default": "./dist/ai/onnx/web.js"
    },
    "./ai/onnx/node": {
      "types": "./dist/ai/onnx/node.d.ts",
      "default": "./dist/ai/onnx/node.js"
    },
    "./utilsui/react": {
      "types": "./dist/utilsui/react.d.ts",
      "default": "./dist/utilsui/react.js"
    },
    "./utilsui/toast": {
      "types": "./dist/utilsui/toast/index.d.ts",
      "default": "./dist/utilsui/toast/index.js"
